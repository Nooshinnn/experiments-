# ---- Plot 8: Threshold Sweep — New Model on New Test Set ----
def plot_threshold_sweep():
    thresholds = np.linspace(0.01, 0.99, 200)
    sweep = {"F1": [], "MCC": [], "Precision": [], "Recall": []}
    for t in thresholds:
        pred_t = (nt_new_prob >= t).astype(int)
        sweep["F1"].append(f1_score(nt_new_true, pred_t, zero_division=0))
        sweep["MCC"].append(matthews_corrcoef(nt_new_true, pred_t))
        sweep["Precision"].append(precision_score(nt_new_true, pred_t, zero_division=0))
        sweep["Recall"].append(recall_score(nt_new_true, pred_t, zero_division=0))

    best_f1  = thresholds[int(np.argmax(sweep["F1"]))]
    best_mcc = thresholds[int(np.argmax(sweep["MCC"]))]

    fig, ax = plt.subplots(figsize=(9, 5))
    colors_m = {"F1": "#4C72B0", "MCC": "#DD8452",
                "Precision": "#55A868", "Recall": "#C44E52"}
    for m, vals in sweep.items():
        ax.plot(thresholds, vals, lw=2, label=m, color=colors_m[m])
    ax.axvline(best_f1,  color="#4C72B0", linestyle='--', lw=1.2,
               label=f"Best F1 @ {best_f1:.2f}")
    ax.axvline(best_mcc, color="#DD8452", linestyle='--', lw=1.2,
               label=f"Best MCC @ {best_mcc:.2f}")
    ax.axvline(0.5, color='black', linestyle=':', lw=1, label="Default (0.5)")
    ax.set_xlabel("Decision Threshold"); ax.set_ylabel("Metric Value")
    ax.set_title("Threshold Sweep — New Model on New Test Set", fontweight='bold')
    ax.legend(fontsize=8, ncol=2); ax.set_xlim(0, 1); ax.set_ylim(-0.05, 1.05)
    plt.tight_layout()
    plt.savefig(f"{PLOT_DIR}/08_threshold_sweep.png", bbox_inches='tight')
    plt.close()
    print("  Saved: 08_threshold_sweep.png")
    return float(best_f1), float(best_mcc)


