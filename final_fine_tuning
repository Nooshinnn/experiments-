    # Left: Old Test Set
    for label, yt, yp, color, ls in [
        ("Old Model", ot_old_true, ot_old_prob, PALETTE["old_model"], "-"),
        ("New Model", nt_old_true, nt_old_prob, PALETTE["new_model"], "--"),
    ]:
