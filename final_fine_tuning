# ---- Plot 11: Delta (improvement) heat-strip ----
def plot_delta_heatmap():
    display_metrics = [
        "Accuracy", "Precision", "Recall (Sens.)", "Specificity",
        "F1-Score", "MCC", "Cohen's Kappa", "ROC-AUC",
        "Avg Precision", "Log Loss", "Brier Score", "NPV", "FPR", "FNR",
    ]
    # Positive delta = improvement for most; Log Loss, Brier, FPR, FNR = lower is better
    lower_is_better = {"Log Loss", "Brier Score", "FPR", "FNR"}

    delta_old = {}
    delta_new = {}
    for m in display_metrics:
        raw_old = new_model_on_old[m] - old_model_on_old[m]
        raw_new = new_model_on_new[m] - old_model_on_new[m]
        # Flip sign so positive always = improvement
        delta_old[m] = -raw_old if m in lower_is_better else raw_old
        delta_new[m] = -raw_new if m in lower_is_better else raw_new

    df_delta = pd.DataFrame({
        "Old Test Set": delta_old,
        "New Test Set": delta_new,
    }).T

    fig, ax = plt.subplots(figsize=(14, 3))
    sns.heatmap(df_delta, annot=True, fmt=".4f", ax=ax,
                cmap="RdYlGn", center=0,
                linewidths=0.4, linecolor='white',
                cbar_kws={"label": "Δ (New − Old)  [positive = improved]"})
    ax.set_title("Performance Delta: New Model − Old Model\n"
                 "(positive = improvement; Log Loss / Brier / FPR / FNR signs already flipped)",
                 fontsize=12, fontweight='bold', pad=10)
    ax.set_yticklabels(ax.get_yticklabels(), rotation=0)
    ax.set_xticklabels(ax.get_xticklabels(), rotation=35, ha='right')
    plt.tight_layout()
    plt.savefig(f"{PLOT_DIR}/11_delta_heatmap.png", bbox_inches='tight')
    plt.close()
    print("  Saved: 11_delta_heatmap.png")


